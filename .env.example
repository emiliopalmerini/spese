# Environment variables for spese v2 (sheets-only accounting rebuild).

# Google Sheets (required)
GOOGLE_SPREADSHEET_ID=1BgDhwk-rQOoArP2LS4eNwXO8FLHCqK8shxh0q292Aqw
GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json

# HTTP
SPESE_PORT=8080

# How often the recurring processor scans the `recurring` tab and fires due
# transactions. Idempotent: re-running mid-day does nothing once the day's
# transactions have been written.
RECURRING_PROCESSOR_INTERVAL=6h
