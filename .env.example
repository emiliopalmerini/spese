# Environment variables for Spese local development.

# Honker is required for the durable sheet-mirror outbox.
HONKER_EXTENSION_PATH=/path/to/libhonker_ext.dylib

# HTTP
SPESE_PORT=8080
SPESE_DB_PATH=tmp/spese-local.db

# Local worker testing: exercises Honker + the sheet mirror without Google.
SPESE_SHEET_MIRROR_BACKEND=local
SPESE_LOCAL_SHEET_PATH=tmp/local-sheet.json

# Google worker testing / production:
# SPESE_SHEET_MIRROR_BACKEND=google
# GOOGLE_SPREADSHEET_ID=...
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json
